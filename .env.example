# 进化湾 管理后台 — 环境变量配置
# 复制此文件为 .env 并填入真实值，生产环境务必修改默认值

# Flask 密钥（用于 session 加密）
FLASK_SECRET_KEY=change-me-to-a-random-string

# 数据库路径
DB_PATH=/path/to/evolution_bay_leads.db

# 管理后台 SPA 静态文件路径
ADMIN_SPA_DIR=/path/to/frontend/admin

# 管理员账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# API Token 签名密钥（用于 HMAC 签名，需与 FLASK_SECRET_KEY 不同）
TOKEN_SECRET=change-me-to-another-random-string

# Token 过期时间（小时）
TOKEN_EXPIRY_HOURS=12

# 旧版兼容 token（可选，留空则禁用）
LEGACY_TOKEN=
